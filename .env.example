# ===========================================================================
# RV Retail Forecast Dashboard - Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ===========================================================================

# --- File Paths ---
# Path to the primary RV Retail customer data Excel file (RV_Cust_Data.xlsx)
DATA_PATH=./data/RV_Cust_Data.xlsx

# Directory where generated Parquet files will be stored (read by Streamlit dashboard)
PARQUET_DIR=./parquet

# Path to the RVIA shipment index Excel file (optional, fallback curve used if absent)
RVIA_PATH=./data/Retail OEM RV shipment.xlsx

# Output path for Dometic monthly sales summaries from D365
DOMETIC_SALES_OUT=./data/dometic_sales_by_parent.xlsx

# Output path for the Attach Rate Projection Excel workbook
ATTACH_RATE_OUT=./output/Dometic_Sales_Projection.xlsx

# Output path for the Data Quality Check Excel report
QC_OUT_PATH=./output/Data_Quality_Report.xlsx

# Archive directory for timestamped run snapshots (set to 'none' to disable)
ARCHIVE_DIR=./archive


# --- Macro Signals (FRED API) ---
# FRED API key from St. Louis Fed for consumer sentiment, interest rates, gas prices
# Register free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=


# --- Pipeline Configuration & Modeling ---
# Comma-separated list of your company's own divisions for market share calculation
OWN_DIVISIONS=

# Number of rolling-origin backtest folds (default: 3)
ROLLING_ORIGINS=3

# RVIA year blending weights (format: YYYY:weight, YYYY:weight)
RVIA_YEAR_WEIGHTS=2024:0.35, 2025:0.65

# Parallel worker cores (-1 for all available cores, 1 for sequential)
N_JOBS=-1

# Maximum parallel processes when running deep foundation models (TimesFM/Chronos)
HEAVY_MODEL_MAX_JOBS=4


# --- D365 MSSQL Connection (Required for pull_dometic_sales.py) ---
D365_SQL_SERVER=
D365_SQL_DATABASE=
D365_SQL_USER=
D365_SQL_PASSWORD=
